{
  "manifest_version": 1,
  "id": "artifacts",
  "name": "ARTIFACTS",
  "summary": "Pages you and an agent can mark up together. Every drawing stays attached to a named element, so either side can understand it without trading screenshots.",
  "category": "studio",
  "maker": {
    "name": "OpenRig",
    "url": "https://github.com/openrig"
  },
  "surface": {
    "entry": "app/artifacts.html",
    "path": "/surfaces/artifacts.html",
    "glyph": "✎",
    "hint": "open an HTML artifact, draw on it, and hand structured annotations to an agent"
  },
  "roots": {
    "artifacts": {
      "required": true
    }
  },
  "calls": {
    "/api/artifacts": { "required": true },
    "/api/artifacts/item": { "required": true },
    "/api/artifacts/annotations": { "required": true },
    "/api/artifacts/screenshot": { "required": true }
  },
  "provider": {
    "package": "@openrig/studio-artifacts",
    "required": true
  }
}
