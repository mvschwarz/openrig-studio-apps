{
  "name": "@openrig/studio-apps",
  "version": "0.1.0",
  "private": true,
  "description": "Apps and providers for OpenRig Studio: pages that run in the Studio shell, and the small local servers they talk to.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvschwarz/openrig-studio-apps.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:comments": "node scripts/check-comments.mjs",
    "pin": "node scripts/pin-vendor.mjs",
    "check": "npm run lint && npm run format:check && npm run check:comments && npm test"
  },
  "openrig": {
    "requires": {
      "studioSdk": ">=0.9.0-pre.1",
      "studioContract": "v0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
