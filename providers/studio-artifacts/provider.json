{
  "package": "@openrig/studio-artifacts",
  "run": {
    "entry": "artifacts-server.mjs",
    "args": [
      "--port",
      "{{port}}",
      "--root",
      "{{root:artifacts}}"
    ]
  },
  "serves": [
    "/artifacts/"
  ],
  "verbs": [
    "/api/artifacts",
    "/api/artifacts/item",
    "/api/artifacts/annotations",
    "/api/artifacts/screenshot"
  ]
}
