{
  "package": "@openrig/studio-host",
  "run": {
    "entry": "host-server.mjs",
    "args": [
      "--port",
      "{{port}}",
      "--root",
      "{{root:project}}",
      "--root",
      "{{root:media}}",
      "--root",
      "{{root:work}}"
    ],
    "companions": [
      {
        "label": "live rig state",
        "entry": "live-state-run.mjs",
        "args": ["--out", "{{state}}", "--interval", "10000"]
      }
    ]
  },
  "verbs": [
    "/api/files/tree",
    "/api/files/read",
    "/api/files/write",
    "/api/files/raw",
    "/api/files/search",
    "/api/files/tags",
    "/api/files/goto",
    "/api/files/roots"
  ]
}
